# Builds the testing app image with the minimal patch set required for the
# NRP InvenioRDM platform to function correctly. All acceptance tests except
# PLT-021-a target this image.
#
# Current patch set
# -----------------
# Patch 1 — oarepo-model fork (billyziege/oarepo-model, zerbe_patching_to_get_dantec_working)
#   Installs the fork as an explicit direct dependency so that uv's
#   [tool.uv.sources] override actually applies (overrides only work for
#   direct deps, not transitive ones). The fork carries LazyPIDFieldProxy
#   (add_pid_relation.py) + lazy _pid_field() (relations.py) that defer
#   record_cls resolution to runtime, fixing the self-referential circular
#   import that upstream oarepo-model 2.4.x does not handle.
#
# Patch minimization
# ------------------
# Re-run PLT-021-a against Dockerfile.cold on each new NRP upstream release.
# If PLT-021-a passes, this patch can be retired and both Dockerfiles become
# equivalent.

ARG PYTHON_VERSION=3.14

FROM python:${PYTHON_VERSION}-slim AS builder

# Build deps: C-extension wheels + Node/pnpm for webpack.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git curl ca-certificates pkg-config \
        libpq-dev libxml2-dev libxslt1-dev libffi-dev libssl-dev \
        rustc cargo libcairo2 \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g pnpm@10.32.1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

ENV UV_EXTRA_INDEX_URL=https://gitlab.cesnet.cz/api/v4/projects/1408/packages/pypi/simple \
    PIP_EXTRA_INDEX_URL=https://gitlab.cesnet.cz/api/v4/projects/1408/packages/pypi/simple \
    UV_PRERELEASE=allow \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

COPY . .

# Activate fork overrides: swap in the patched pyproject before resolving.
# pyproject.patched.toml adds oarepo-model as a direct dep + [tool.uv.sources]
# pointing to the billyziege fork so uv installs the LazyPIDFieldProxy fix.
RUN cp pyproject.patched.toml pyproject.toml \
    && uv sync --python="${PYTHON_VERSION}"

ENV PATH="/app/.venv/bin:${PATH}"

RUN instance_path="$(invenio shell --no-term-title -c "print(app.instance_path, end='')")" \
    && mkdir -p "${instance_path}" \
    && ln -sf /app/invenio.cfg "${instance_path}/invenio.cfg" \
    && ln -sf /app/templates "${instance_path}/templates" \
    && ln -sf /app/translations "${instance_path}/translations" \
    && ln -sf /app/app_data "${instance_path}/app_data"

RUN invenio collect -v
# buildall = create + install (pnpm install) + build
RUN invenio webpack buildall

# ---- Runtime stage ----
FROM python:${PYTHON_VERSION}-slim AS runtime

# libxml2 is required by uwsgi's shared-library deps; libcairo2 by cairosvg.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 curl libcairo2 libxml2 \
    && rm -rf /var/lib/apt/lists/*

# python:*-slim has no LANG/LC_ALL; babel fails hard on POSIX/C locale.
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY . .
COPY docker/development.crt docker/development.key /

ENV PATH="/app/.venv/bin:${PATH}" \
    UV_PROJECT_ENVIRONMENT=/app/.venv

EXPOSE 5000 8443

ENTRYPOINT ["docker/entrypoint.sh"]
CMD ["uwsgi", "--ini", "docker/uwsgi.ini", "--lazy-apps"]
