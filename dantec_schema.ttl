<https://vocab.dantec.cz/pshapes/DOIActivityDescription> a sh:PropertyShape ;
    skos:exactMatch <https://w3id.org/tib/datacite/property/description> ;
    sh:datatype xsd:string ;
    sh:description "Already in CCCM"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Description"@en ;
    sh:path <https://vocab.dantec.cz/prop/DOIActivityDescription> ;
    dantec:ccmmExport "CCMMDataSet.descriptions[description_type=abstract].description_text"@en ;
    dantec:facetable false ;
    dantec:obligation "optional"@en ;
    dantec:searchable false .

<https://vocab.dantec.cz/pshapes/DOIActivityEmbargoDate> a sh:PropertyShape ;
    skos:exactMatch ccmm:hasTimeReference ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Embargo end date"@en ;
    sh:path <https://vocab.dantec.cz/prop/DOIActivityEmbargoDate> ;
    dantec:ccmmExport "CCMMDataSet.time_references[date_type=Available].temporal_representation.time_instant.date"@en ;
    dantec:facetable false ;
    dantec:obligation "optional"@en ;
    dantec:searchable false .

<https://vocab.dantec.cz/pshapes/DOIActivityEndDate> a sh:PropertyShape ;
    skos:exactMatch ccmm:hasTimeReference ;
    sh:datatype xsd:date ;
    sh:description "control in CCCM"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "End date"@en ;
    sh:path <https://vocab.dantec.cz/prop/DOIActivityEndDate> ;
    dantec:ccmmExport "CCMMDataSet.time_references[date_type=CollectedEnd].temporal_representation.time_instant.date"@en ;
    dantec:facetable true ;
    dantec:obligation "optional"@en ;
    dantec:searchable true .

<https://vocab.dantec.cz/pshapes/DOIActivityLicense> a sh:PropertyShape ;
