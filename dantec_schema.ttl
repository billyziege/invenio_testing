@prefix ccmm: <https://model.ccmm.cz/vocabulary/ccmm#> .
@prefix dantec: <https://vocab.dantec.cz/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://vocab.dantec.cz/shapes/DOIActivityShape> a sh:NodeShape ;
    skos:prefLabel "Activity"@en ;
    sh:property <https://vocab.dantec.cz/pshapes/DOIActivityAccessRights>,
        <https://vocab.dantec.cz/pshapes/DOIActivityAttributes>,
        <https://vocab.dantec.cz/pshapes/DOIActivityDescription>,
        <https://vocab.dantec.cz/pshapes/DOIActivityEmbargoDate>,
        <https://vocab.dantec.cz/pshapes/DOIActivityEndDate>,
        <https://vocab.dantec.cz/pshapes/DOIActivityLicense>,
        <https://vocab.dantec.cz/pshapes/DOIActivityProvenanceStatement>,
        <https://vocab.dantec.cz/pshapes/DOIActivityRelatedItems>,
        <https://vocab.dantec.cz/pshapes/DOIActivityStartDate>,
        <https://vocab.dantec.cz/pshapes/DOIActivitySteps>,
        <https://vocab.dantec.cz/pshapes/DOIActivitySubjects>,
        <https://vocab.dantec.cz/pshapes/DOIActivityTitle>,
        <https://vocab.dantec.cz/pshapes/DOIActivityType> ;
    sh:targetClass <https://vocab.dantec.cz/class/DOIActivity> .

<https://vocab.dantec.cz/pshapes/DOIActivityAccessRights> a sh:PropertyShape ;
    skos:exactMatch dcterms:accessRights ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Access rights"@en ;
    sh:path <https://vocab.dantec.cz/prop/DOIActivityAccessRights> ;
    dantec:ccmmExport "CMMDataSet.terms_of_use.access_rights (vocab: accessrights)"@en ;
    dantec:facetable true ;
    dantec:obligation "required"@en ;
    dantec:searchable false .

<https://vocab.dantec.cz/pshapes/DOIActivityAttributes> a sh:PropertyShape ;
    sh:minCount 0 ;
    sh:name "Activity attributes"@en ;
    sh:node <https://vocab.dantec.cz/shapes/DOIActivityAttributesShape> ;
    sh:path <https://vocab.dantec.cz/prop/DOIActivityAttributes> ;
    dantec:facetable false ;
    dantec:obligation "[0,6 ]"@en ;
    dantec:searchable true .

<https://vocab.dantec.cz/pshapes/DOIActivityAttributesName> a sh:PropertyShape ;
