    dantec:ccmmExport "CCMMDataSet.provenances[].label"@en ;
    dantec:facetable false ;
    dantec:obligation "optionnal"@en ;
    dantec:searchable true .

<https://vocab.dantec.cz/pshapes/DOIActivityRelatedItems> a sh:PropertyShape ;
